# Normalize all text files to LF in the repository.
# Git auto-detects text vs binary; text files are stored as LF and
# checked out as LF on every platform, killing CRLF diff noise.
* text=auto eol=lf

# Explicit text types (belt-and-suspenders for common extensions here)
*.cs        text eol=lf
*.csproj    text eol=lf
*.slnx      text eol=lf
*.sln       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.txt       text eol=lf
*.sh        text eol=lf

# Windows-only scripts must stay CRLF to run correctly
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files: never touch line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.dll       binary
*.zip       binary
*.gz        binary
